---
/**
 * 文章详情页布局
 */
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '@components/common/Breadcrumb.astro';
import TOC from '@components/blog/TOC.astro';
import ProductCta from '@components/blog/ProductCta.astro';
import type { MarkdownHeading } from 'astro';
import type { ProductLink } from '@utils/products';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  tags?: string[];
  schema?: Record<string, unknown> | Record<string, unknown>[];
  breadcrumbs?: { label: string; href?: string }[];
  headings?: MarkdownHeading[];
  products?: ProductLink[];
}

const {
  title,
  description,
  canonical,
  image,
  type = 'article',
  publishedTime,
  modifiedTime,
  author,
  tags,
  schema,
  breadcrumbs = [],
  headings = [],
  products = [],
} = Astro.props;

const showAside = headings.length > 0 || products.length > 0;
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  image={image}
  type={type}
  publishedTime={publishedTime}
  modifiedTime={modifiedTime}
  author={author}
  tags={tags}
  schema={schema}
>
  <div class="container-site py-8 lg:py-10">
    {breadcrumbs.length > 0 && (
      <div class="mb-6">
        <Breadcrumb items={breadcrumbs} />
      </div>
    )}
    <div class:list={['grid gap-10', showAside && 'xl:grid-cols-[1fr_240px]']}>
      <article class="min-w-0">
        <slot />
      </article>
      {showAside && (
        <aside class="hidden xl:block">
          <div class="sticky top-24 space-y-5">
            {headings.length > 0 && <TOC headings={headings} />}
            {products.length > 0 && (
              <ProductCta
                products={products}
                compact
                title="使用入口"
                description=""
              />
            )}
          </div>
        </aside>
      )}
    </div>
  </div>
</BaseLayout>
