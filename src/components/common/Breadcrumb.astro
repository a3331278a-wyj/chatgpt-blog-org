---
/**
 * 面包屑导航
 */
export interface BreadcrumbItem {
  label: string;
  href?: string;
}

export interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
---

<nav aria-label="面包屑">
  <ol class="flex flex-wrap items-center gap-1.5 text-sm text-ink-500">
    {
      items.map((item, index) => (
        <li class="flex items-center gap-1.5">
          {index > 0 && (
            <span class="text-ink-300" aria-hidden="true">
              /
            </span>
          )}
          {item.href && index < items.length - 1 ? (
            <a href={item.href} class="hover:text-brand-600">
              {item.label}
            </a>
          ) : (
            <span class="font-medium text-ink-800" aria-current="page">
              {item.label}
            </span>
          )}
        </li>
      ))
    }
  </ol>
</nav>
