---
/**
 * 站点页脚
 */
import { friendLinks, siteConfig, modelHubs } from '@config/site';

const year = new Date().getFullYear();
---

<footer class="mt-auto border-t border-ink-200 bg-white">
  <div class="container-site py-10">
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      <div class="lg:col-span-1">
        <p class="font-display text-lg font-bold text-ink-950">{siteConfig.name}</p>
        <p class="mt-2 max-w-sm text-sm leading-relaxed text-ink-600">
          {siteConfig.description}
        </p>
      </div>

      <div>
        <h2 class="text-sm font-semibold uppercase tracking-wide text-ink-500">内容导航</h2>
        <ul class="mt-3 space-y-2 text-sm">
          <li><a class="text-ink-700 hover:text-brand-600" href="/guides/">教程指南</a></li>
          <li><a class="text-ink-700 hover:text-brand-600" href="/compare/">模型评测</a></li>
          <li><a class="text-ink-700 hover:text-brand-600" href="/news/">AI 快讯</a></li>
          <li><a class="text-ink-700 hover:text-brand-600" href="/tools/">AI 工具</a></li>
          <li><a class="text-ink-700 hover:text-brand-600" href="/access/">访问说明</a></li>
          <li><a class="text-ink-700 hover:text-brand-600" href="/faq/">常见问题</a></li>
        </ul>
      </div>

      <div>
        <h2 class="text-sm font-semibold uppercase tracking-wide text-ink-500">模型专栏</h2>
        <ul class="mt-3 space-y-2 text-sm">
          {
            modelHubs.map((hub) => (
              <li>
                <a class="text-ink-700 hover:text-brand-600" href={hub.href}>
                  {hub.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2 class="text-sm font-semibold uppercase tracking-wide text-ink-500">关于</h2>
        <ul class="mt-3 space-y-2 text-sm">
          <li><a class="text-ink-700 hover:text-brand-600" href="/about/">关于我们</a></li>
          <li><a class="text-ink-700 hover:text-brand-600" href="/authors/">作者编辑部</a></li>
          <li><a class="text-ink-700 hover:text-brand-600" href="/privacy/">隐私政策</a></li>
          <li><a class="text-ink-700 hover:text-brand-600" href="/tags/">文章标签</a></li>
          <li><a class="text-ink-700 hover:text-brand-600" href="/sitemap/">网站地图</a></li>
          <li><a class="text-ink-700 hover:text-brand-600" href="/rss.xml">RSS 订阅</a></li>
          <li><a class="text-ink-700 hover:text-brand-600" href="/search/">站内搜索</a></li>
        </ul>
        <h2 class="mt-6 text-sm font-semibold uppercase tracking-wide text-ink-500">友情链接</h2>
        <ul class="mt-3 flex flex-wrap gap-x-4 gap-y-2 text-sm">
          {
            friendLinks.map((link) => (
              <li>
                <a
                  class="text-ink-700 hover:text-brand-600"
                  href={link.href}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {link.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="mt-8 border-t border-ink-100 pt-6 text-center text-sm text-ink-500">
      <p>
        &copy; {year} {siteConfig.name} · {siteConfig.url.replace('https://', '')}
      </p>
      <p class="mt-1">{siteConfig.disclaimer}</p>
    </div>
  </div>
</footer>
