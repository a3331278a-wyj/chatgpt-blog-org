---
/**
 * FAQ 折叠面板
 */
export interface FaqItem {
  question: string;
  answer: string;
}

export interface Props {
  items: readonly FaqItem[] | FaqItem[];
}

const { items } = Astro.props;
---

<div class="space-y-3">
  {
    items.map((item, index) => (
      <details
        class="group rounded-xl border border-ink-200 bg-white open:shadow-sm"
        open={index === 0}
      >
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 font-medium text-ink-900 marker:content-none">
          <span>{item.question}</span>
          <span
            class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-ink-100 text-ink-600 transition group-open:rotate-45 group-open:bg-brand-50 group-open:text-brand-700"
            aria-hidden="true"
          >
            +
          </span>
        </summary>
        <div class="border-t border-ink-100 px-5 py-4 text-sm leading-relaxed text-ink-600">
          {item.answer}
        </div>
      </details>
    ))
  }
</div>
