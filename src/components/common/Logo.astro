---
/**
 * 站点 Logo 标识（对话气泡 + 指南线条）
 */
export interface Props {
  class?: string;
  size?: number;
}

const { class: className = '', size = 36 } = Astro.props;
---

<img
  src="/images/logo.svg"
  alt=""
  width={size}
  height={size}
  class:list={['shrink-0 rounded-lg shadow-sm transition group-hover:opacity-90', className]}
  decoding="async"
/>
