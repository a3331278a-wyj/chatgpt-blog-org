---
/**
 * AI 工具卡片
 */
import type { ToolEntry } from '@utils/guides';
import { getToolCategoryName } from '@utils/tools';
import ToolIcon from './ToolIcon.astro';

export interface Props {
  tool: ToolEntry;
}

const { tool } = Astro.props;
const { name, description, category, url, tags, icon } = tool.data;
const detailHref = `/tools/${tool.id}/`;
---

<article class="flex h-full flex-col rounded-xl border border-ink-200 bg-white p-5 shadow-sm card-hover">
  <div class="flex items-start gap-3">
    <div
      class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-brand-50 text-brand-700"
      aria-hidden="true"
    >
      <ToolIcon name={icon} />
    </div>
    <div class="min-w-0">
      <h3 class="font-semibold text-ink-950">
        <a href={detailHref} class="hover:text-brand-700">{name}</a>
      </h3>
      <p class="mt-0.5 text-xs text-ink-500">{getToolCategoryName(category)}</p>
    </div>
  </div>
  <p class="mt-3 flex-1 text-sm leading-relaxed text-ink-600">{description}</p>
  {
    tags.length > 0 && (
      <div class="mt-3 flex flex-wrap gap-1.5">
        {tags.slice(0, 3).map((tag: string) => (
          <span class="rounded bg-ink-50 px-2 py-0.5 text-xs text-ink-600">{tag}</span>
        ))}
      </div>
    )
  }
  <div class="mt-4 flex flex-wrap items-center gap-3 text-sm font-semibold">
    <a href={detailHref} class="text-ink-700 hover:text-brand-700">详情</a>
    <a
      href={url}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-1 text-brand-600 hover:text-brand-700"
    >
      访问
      <span aria-hidden="true">→</span>
    </a>
  </div>
</article>
