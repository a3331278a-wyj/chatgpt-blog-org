---
/**
 * 相关阅读推荐
 */
import type { GuideEntry } from '@utils/guides';
import { formatDate, getCategoryName } from '@utils/guides';

export interface Props {
  guides: GuideEntry[];
}

const { guides } = Astro.props;
---

{
  guides.length > 0 && (
    <section class="mt-12 border-t border-ink-200 pt-10" aria-labelledby="related-heading">
      <h2 id="related-heading" class="font-display text-xl font-bold text-ink-950">
        相关阅读
      </h2>
      <ul class="mt-5 grid gap-4 sm:grid-cols-3">
        {guides.map((guide) => (
          <li>
            <a
              href={`/guides/${guide.id}/`}
              class="block h-full rounded-xl border border-ink-200 bg-white p-4 shadow-sm transition hover:border-brand-300 hover:shadow-md"
            >
              <span class="tag">{getCategoryName(guide.data.category)}</span>
              <span class="mt-2 block font-semibold leading-snug text-ink-900">
                {guide.data.title}
              </span>
              <time
                class="mt-2 block text-xs text-ink-500"
                datetime={guide.data.pubDate.toISOString()}
              >
                {formatDate(guide.data.pubDate)}
              </time>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}
