---
/**
 * 侧边栏：分类 / 热门 / 标签云
 */
import type { GuideEntry } from '@utils/guides';
import { categories } from '@config/site';
import { getCategoryName, tagToParam } from '@utils/guides';

export interface Props {
  popularGuides: GuideEntry[];
  tags: { tag: string; count: number }[];
  activeCategory?: string;
}

const { popularGuides, tags, activeCategory } = Astro.props;
---

<section class="sidebar-card" aria-labelledby="sidebar-models">
  <h2 id="sidebar-models" class="text-sm font-semibold text-ink-900">模型专栏</h2>
  <ul class="mt-3 space-y-1.5">
    <li><a href="/guides/chatgpt/" class="block rounded-lg px-2.5 py-2 text-sm text-ink-700 hover:bg-ink-50">ChatGPT</a></li>
    <li><a href="/guides/claude/" class="block rounded-lg px-2.5 py-2 text-sm text-ink-700 hover:bg-ink-50">Claude</a></li>
    <li><a href="/guides/gemini/" class="block rounded-lg px-2.5 py-2 text-sm text-ink-700 hover:bg-ink-50">Gemini</a></li>
    <li><a href="/guides/grok/" class="block rounded-lg px-2.5 py-2 text-sm text-ink-700 hover:bg-ink-50">Grok</a></li>
    <li><a href="/compare/" class="block rounded-lg px-2.5 py-2 text-sm text-ink-700 hover:bg-ink-50">模型评测对比</a></li>
    <li><a href="/news/" class="block rounded-lg px-2.5 py-2 text-sm text-ink-700 hover:bg-ink-50">AI 快讯</a></li>
    <li><a href="/access/" class="block rounded-lg px-2.5 py-2 text-sm text-ink-700 hover:bg-ink-50">访问与使用说明</a></li>
  </ul>
</section>

<section class="sidebar-card" aria-labelledby="sidebar-categories">
  <h2 id="sidebar-categories" class="text-sm font-semibold text-ink-900">分类目录</h2>
  <ul class="mt-3 space-y-1.5">
    {
      categories.map((cat) => (
        <li>
          <a
            href={`/guides/category/${cat.slug}/`}
            class:list={[
              'flex items-center justify-between rounded-lg px-2.5 py-2 text-sm transition',
              activeCategory === cat.slug
                ? 'bg-brand-50 font-medium text-brand-700'
                : 'text-ink-700 hover:bg-ink-50',
            ]}
          >
            <span>{cat.name}</span>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<section class="sidebar-card" aria-labelledby="sidebar-popular">
  <h2 id="sidebar-popular" class="text-sm font-semibold text-ink-900">热门文章</h2>
  <ol class="mt-3 space-y-3">
    {
      popularGuides.slice(0, 5).map((guide, index) => (
        <li class="flex gap-3">
          <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-md bg-ink-100 text-xs font-bold text-ink-600">
            {index + 1}
          </span>
          <div class="min-w-0">
            <a
              href={`/guides/${guide.id}/`}
              class="line-clamp-2 text-sm font-medium leading-snug text-ink-800 hover:text-brand-600"
            >
              {guide.data.title}
            </a>
            <p class="mt-0.5 text-xs text-ink-500">{getCategoryName(guide.data.category)}</p>
          </div>
        </li>
      ))
    }
  </ol>
</section>

{
  tags.length > 0 && (
    <section class="sidebar-card" aria-labelledby="sidebar-tags">
      <h2 id="sidebar-tags" class="text-sm font-semibold text-ink-900">标签云</h2>
      <div class="mt-3 flex flex-wrap gap-2">
        {tags.slice(0, 20).map(({ tag, count }) => (
          <a
            href={`/tags/${tagToParam(tag)}/`}
            class="rounded-md bg-ink-50 px-2.5 py-1 text-xs text-ink-700 transition hover:bg-brand-50 hover:text-brand-700"
            title={`${count} 篇文章`}
          >
            {tag}
            <span class="ml-1 text-ink-400">{count}</span>
          </a>
        ))}
      </div>
      <a href="/tags/" class="mt-3 inline-block text-xs font-semibold text-brand-600 hover:underline">
        全部标签 →
      </a>
    </section>
  )
}
