---
/**
 * 模型使用入口 CTA
 */
import type { ProductLink } from '@utils/products';

export interface Props {
  products: ProductLink[];
  title?: string;
  description?: string;
  /** 侧栏紧凑样式 */
  compact?: boolean;
}

const {
  products,
  title = '立即体验',
  description = '边学边练，打开对应模型开始对话。',
  compact = false,
} = Astro.props;
---

{
  products.length > 0 && (
    <aside
      class:list={[
        'rounded-xl border border-brand-200 bg-brand-50/70',
        compact ? 'p-4' : 'p-5 sm:p-6',
      ]}
      aria-label="模型使用入口"
    >
      <p class:list={['font-display font-bold text-ink-950', compact ? 'text-sm' : 'text-base']}>
        {title}
      </p>
      {!compact && description ? (
        <p class="mt-1.5 text-sm leading-relaxed text-ink-600">{description}</p>
      ) : null}
      <div class:list={['flex flex-wrap gap-2', compact ? 'mt-3' : 'mt-4']}>
        {products.map((product) => (
          <a
            href={product.url}
            target="_blank"
            rel="noopener noreferrer"
            class:list={[
              'inline-flex items-center justify-center rounded-lg font-semibold transition',
              compact
                ? 'bg-brand-600 px-3 py-1.5 text-xs text-white hover:bg-brand-700'
                : 'btn-primary text-sm',
            ]}
          >
            {compact ? product.name : product.label}
            <span class="ml-1" aria-hidden="true">
              →
            </span>
          </a>
        ))}
      </div>
    </aside>
  )
}
