---
/**
 * 人可读 HTML Sitemap
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/common/Breadcrumb.astro';
import { siteConfig, modelHubs, categories, navLinks } from '@config/site';
import { getPublishedGuides } from '@utils/guides';
import { getAllTools } from '@utils/tools';
import { buildBreadcrumbSchema } from '@utils/schema';

const guides = await getPublishedGuides();
const tools = await getAllTools();

const schema = buildBreadcrumbSchema([
  { name: '首页', url: siteConfig.url },
  { name: '网站地图', url: `${siteConfig.url}/sitemap/` },
]);
---

<BaseLayout
  title="网站地图"
  description="ChatGPT博客全部栏目与文章索引，方便浏览教程、模型专栏、工具与政策页面。"
  canonical="/sitemap/"
  schema={schema}
>
  <div class="container-site py-8 lg:py-10">
    <Breadcrumb items={[{ label: '首页', href: '/' }, { label: '网站地图' }]} />
    <header class="mt-6">
      <h1 class="font-display text-3xl font-bold text-ink-950">网站地图</h1>
      <p class="mt-2 text-ink-600">浏览本站主要栏目与全部教程文章。</p>
    </header>

    <div class="mt-10 grid gap-10 lg:grid-cols-2">
      <section>
        <h2 class="font-display text-xl font-bold text-ink-950">主要页面</h2>
        <ul class="mt-3 space-y-2 text-sm">
          {navLinks.map((link) => (
            <li><a class="text-brand-700 hover:underline" href={link.href}>{link.label}</a></li>
          ))}
          <li><a class="text-brand-700 hover:underline" href="/compare/">模型评测</a></li>
          <li><a class="text-brand-700 hover:underline" href="/news/">AI 快讯</a></li>
          <li><a class="text-brand-700 hover:underline" href="/access/">访问与使用说明</a></li>
          <li><a class="text-brand-700 hover:underline" href="/authors/">作者编辑部</a></li>
          <li><a class="text-brand-700 hover:underline" href="/privacy/">隐私政策</a></li>
          <li><a class="text-brand-700 hover:underline" href="/search/">站内搜索</a></li>
          <li><a class="text-brand-700 hover:underline" href="/tags/">文章标签</a></li>
          <li><a class="text-brand-700 hover:underline" href="/rss.xml">RSS</a></li>
          <li><a class="text-brand-700 hover:underline" href="/sitemap/">网站地图</a></li>
        </ul>
      </section>

      <section>
        <h2 class="font-display text-xl font-bold text-ink-950">模型专栏</h2>
        <ul class="mt-3 space-y-2 text-sm">
          {modelHubs.map((hub) => (
            <li><a class="text-brand-700 hover:underline" href={hub.href}>{hub.name} 教程中心</a></li>
          ))}
        </ul>
        <h2 class="mt-8 font-display text-xl font-bold text-ink-950">教程分类</h2>
        <ul class="mt-3 space-y-2 text-sm">
          {categories.map((cat) => (
            <li>
              <a class="text-brand-700 hover:underline" href={`/guides/category/${cat.slug}/`}>
                {cat.name}
              </a>
            </li>
          ))}
        </ul>
      </section>

      <section class="lg:col-span-2">
        <h2 class="font-display text-xl font-bold text-ink-950">全部文章（{guides.length}）</h2>
        <ul class="mt-3 columns-1 gap-x-8 space-y-2 text-sm sm:columns-2">
          {guides.map((guide) => (
            <li class="break-inside-avoid">
              <a class="text-brand-700 hover:underline" href={`/guides/${guide.id}/`}>
                {guide.data.title}
              </a>
            </li>
          ))}
        </ul>
      </section>

      <section class="lg:col-span-2">
        <h2 class="font-display text-xl font-bold text-ink-950">AI 工具（{tools.length}）</h2>
        <ul class="mt-3 columns-1 gap-x-8 space-y-2 text-sm sm:columns-2">
          {tools.map((tool) => (
            <li class="break-inside-avoid">
              <a class="text-brand-700 hover:underline" href={`/tools/${tool.id}/`}>
                {tool.data.name}
              </a>
            </li>
          ))}
        </ul>
      </section>
    </div>
  </div>
</BaseLayout>
