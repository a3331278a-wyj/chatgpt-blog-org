---
/**
 * 工具详情页（补充外链信息与同分类推荐）
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/common/Breadcrumb.astro';
import ToolCard from '@components/tools/ToolCard.astro';
import ToolIcon from '@components/tools/ToolIcon.astro';
import { siteConfig } from '@config/site';
import { getAllTools, getToolCategoryName } from '@utils/tools';
import { buildBreadcrumbSchema } from '@utils/schema';
import type { ToolEntry } from '@utils/guides';

export async function getStaticPaths() {
  const tools = await getAllTools();
  return tools.map((tool) => ({
    params: { slug: tool.id },
    props: { tool },
  }));
}

interface Props {
  tool: ToolEntry;
}

const { tool } = Astro.props;
const allTools = await getAllTools();
const related = allTools
  .filter((t) => t.id !== tool.id && t.data.category === tool.data.category)
  .slice(0, 3);

const pageUrl = `${siteConfig.url}/tools/${tool.id}/`;
const schema = buildBreadcrumbSchema([
  { name: '首页', url: siteConfig.url },
  { name: 'AI 工具', url: `${siteConfig.url}/tools/` },
  { name: tool.data.name, url: pageUrl },
]);
---

<BaseLayout
  title={`${tool.data.name} - AI 工具介绍`}
  description={tool.data.description}
  canonical={`/tools/${tool.id}/`}
  schema={schema}
>
  <div class="container-site py-8 lg:py-10">
    <Breadcrumb
      items={[
        { label: '首页', href: '/' },
        { label: 'AI 工具', href: '/tools/' },
        { label: tool.data.name },
      ]}
    />

    <article class="mt-6 rounded-2xl border border-ink-200 bg-white p-6 shadow-sm sm:p-8">
      <div class="flex flex-wrap items-start gap-4">
        <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-brand-50 text-brand-700">
          <ToolIcon name={tool.data.icon} class="h-7 w-7" />
        </div>
        <div class="min-w-0 flex-1">
          <p class="text-sm text-ink-500">{getToolCategoryName(tool.data.category)}</p>
          <h1 class="mt-1 font-display text-3xl font-bold text-ink-950">{tool.data.name}</h1>
          <p class="mt-3 max-w-2xl text-ink-600">{tool.data.description}</p>
          <div class="mt-4 flex flex-wrap gap-2">
            {
              tool.data.tags.map((tag: string) => (
                <span class="rounded-md bg-ink-50 px-2.5 py-1 text-xs text-ink-600">{tag}</span>
              ))
            }
          </div>
          <a
            href={tool.data.url}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary mt-6"
          >
            访问 {tool.data.name}
          </a>
        </div>
      </div>
    </article>

    {
      related.length > 0 && (
        <section class="mt-12" aria-labelledby="related-tools">
          <h2 id="related-tools" class="font-display text-xl font-bold text-ink-950">
            同分类推荐
          </h2>
          <div class="mt-5 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {related.map((item) => (
              <ToolCard tool={item} />
            ))}
          </div>
        </section>
      )
    }
  </div>
</BaseLayout>
