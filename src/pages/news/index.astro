---
/**
 * 快讯列表
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/common/Breadcrumb.astro';
import { siteConfig } from '@config/site';
import { getPublishedNews, formatNewsDate } from '@utils/news';
import { buildBreadcrumbSchema } from '@utils/schema';

const news = await getPublishedNews();
const schema = buildBreadcrumbSchema([
  { name: '首页', url: siteConfig.url },
  { name: '快讯', url: `${siteConfig.url}/news/` },
]);
---

<BaseLayout
  title="AI 快讯与更新"
  description="跟踪 ChatGPT、Claude、Gemini、Grok 等大模型的重要更新与使用趋势，短讯速览，长文见教程专栏。"
  canonical="/news/"
  schema={schema}
>
  <div class="container-site py-8 lg:py-10">
    <Breadcrumb items={[{ label: '首页', href: '/' }, { label: '快讯' }]} />
    <header class="mt-6 max-w-2xl">
      <h1 class="font-display text-3xl font-bold text-ink-950">AI 快讯</h1>
      <p class="mt-3 text-ink-600">
        用短文跟踪版本与工作流变化；需要系统学习请前往
        <a href="/guides/" class="text-brand-600 hover:underline">教程指南</a>。
      </p>
    </header>

    <ul class="mt-10 space-y-4">
      {
        news.map((item) => (
          <li>
            <a
              href={`/news/${item.id}/`}
              class="block rounded-xl border border-ink-200 bg-white p-5 shadow-sm transition hover:border-brand-300"
            >
              <time class="text-xs text-ink-500" datetime={item.data.pubDate.toISOString()}>
                {formatNewsDate(item.data.pubDate)}
              </time>
              <h2 class="mt-2 font-display text-lg font-bold text-ink-950">{item.data.title}</h2>
              <p class="mt-2 text-sm text-ink-600">{item.data.description}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>
