---
/**
 * 站内搜索（基于构建期索引，客户端过滤标题/摘要/正文/标签）
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/common/Breadcrumb.astro';
import { getPublishedGuides, getCategoryName, formatDate } from '@utils/guides';

const guides = await getPublishedGuides();
const searchIndex = guides.map((g) => ({
  slug: g.id,
  title: g.data.title,
  description: g.data.description,
  category: getCategoryName(g.data.category),
  tags: g.data.tags,
  date: formatDate(g.data.pubDate),
  body: (g.body ?? '').slice(0, 2000),
}));

const initialQuery = Astro.url.searchParams.get('q') ?? '';
---

<BaseLayout
  title="站内搜索"
  description="搜索 ChatGPT博客中的教程与指南，按标题、摘要、标签与正文关键词快速查找内容。"
  canonical="/search/"
  noindex={true}
>
  <div class="container-site py-8 lg:py-10">
    <Breadcrumb items={[{ label: '首页', href: '/' }, { label: '搜索' }]} />

    <header class="mt-6 mb-8 max-w-2xl">
      <h1 class="font-display text-3xl font-bold tracking-tight text-ink-950">站内搜索</h1>
      <p class="mt-2 text-ink-600">根据文章标题、摘要、标签与正文关键词查找教程。</p>
    </header>

    <form id="search-form" class="flex flex-col gap-3 sm:flex-row" role="search" action="/search/" method="get">
      <label for="search-input" class="sr-only">搜索关键词</label>
      <input
        id="search-input"
        name="q"
        type="search"
        value={initialQuery}
        placeholder="例如：提示词、API、注册…"
        class="w-full flex-1 rounded-lg border border-ink-200 bg-white px-4 py-2.5 text-ink-900 shadow-sm placeholder:text-ink-400 focus:border-brand-400 focus:outline-none focus:ring-2 focus:ring-brand-200"
        autocomplete="off"
      />
      <button type="submit" class="btn-primary sm:px-8">搜索</button>
    </form>

    <p id="search-status" class="mt-4 text-sm text-ink-500" aria-live="polite"></p>

    <ul id="search-results" class="mt-6 space-y-4"></ul>
  </div>
</BaseLayout>

<script is:inline define:vars={{ searchIndex, initialQuery }}>
  const input = document.getElementById('search-input');
  const form = document.getElementById('search-form');
  const resultsEl = document.getElementById('search-results');
  const statusEl = document.getElementById('search-status');

  function normalize(text) {
    return String(text || '').toLowerCase();
  }

  function search(query) {
    const q = normalize(query).trim();
    if (!q) {
      resultsEl.innerHTML = '';
      statusEl.textContent = '请输入关键词开始搜索。';
      return;
    }

    const tokens = q.split(/\s+/).filter(Boolean);
    const hits = searchIndex
      .map((item) => {
        const haystack = normalize(
          [item.title, item.description, item.category, item.tags.join(' '), item.body].join('\n'),
        );
        const matched = tokens.every((t) => haystack.includes(t));
        let score = 0;
        if (normalize(item.title).includes(q)) score += 5;
        for (const t of tokens) {
          if (normalize(item.title).includes(t)) score += 3;
          if (normalize(item.tags.join(' ')).includes(t)) score += 2;
          if (haystack.includes(t)) score += 1;
        }
        return matched ? { item, score } : null;
      })
      .filter(Boolean)
      .sort((a, b) => b.score - a.score)
      .map((x) => x.item);

    statusEl.textContent = hits.length
      ? `找到 ${hits.length} 条与「${query.trim()}」相关的结果`
      : `未找到与「${query.trim()}」相关的文章`;

    resultsEl.innerHTML = hits
      .map(
        (item) => `
      <li class="rounded-xl border border-ink-200 bg-white p-5 shadow-sm">
        <div class="flex flex-wrap items-center gap-2 text-xs text-ink-500">
          <span class="tag">${item.category}</span>
          <span>${item.date}</span>
        </div>
        <a href="/guides/${item.slug}/" class="mt-2 block font-display text-lg font-bold text-ink-950 hover:text-brand-700">
          ${item.title}
        </a>
        <p class="mt-2 text-sm text-ink-600">${item.description}</p>
      </li>`,
      )
      .join('');
  }

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const q = input?.value || '';
    const url = new URL(window.location.href);
    if (q) url.searchParams.set('q', q);
    else url.searchParams.delete('q');
    window.history.replaceState({}, '', url);
    search(q);
  });

  input?.addEventListener('input', () => {
    search(input.value);
  });

  search(initialQuery);
</script>
