---
/**
 * 文章列表页
 */
import BlogLayout from '@layouts/BlogLayout.astro';
import ArticleCard from '@components/blog/ArticleCard.astro';
import Sidebar from '@components/blog/Sidebar.astro';
import { siteConfig, modelHubs, categories } from '@config/site';
import { getPublishedGuides, getTagCloud, paginate } from '@utils/guides';
import { buildBreadcrumbSchema } from '@utils/schema';

const allGuides = await getPublishedGuides();
const tags = await getTagCloud();
const { items, current, totalPages, total, hasNext } = paginate(
  allGuides,
  1,
  siteConfig.postsPerPage,
);

const schema = buildBreadcrumbSchema([
  { name: '首页', url: siteConfig.url },
  { name: '教程指南', url: `${siteConfig.url}/guides/` },
]);

const learningPath = [
  { title: '新手上手', href: '/guides/what-is-chatgpt-beginner-guide/' },
  { title: '国内使用说明', href: '/guides/chatgpt-china-usage-guide-2026/' },
  { title: '模型怎么选', href: '/guides/chatgpt-vs-claude-vs-gemini/' },
  { title: '提示词模板', href: '/guides/prompt-templates-library/' },
  { title: 'API 入门', href: '/guides/openai-api-nodejs-guide/' },
];
---

<BlogLayout
  title="AI 教程指南"
  description="浏览 ChatGPT、Claude、Gemini 入门教程、国内使用说明、模型对比、提示词、API 开发与 AI 工具指南。"
  canonical="/guides/"
  schema={schema}
  breadcrumbs={[
    { label: '首页', href: '/' },
    { label: '教程指南' },
  ]}
>
  <header class="mb-8">
    <h1 class="font-display text-3xl font-bold tracking-tight text-ink-950">教程指南</h1>
    <p class="mt-2 text-ink-600">共 {total} 篇文章，覆盖入门、选型、提示词、API 与工具实战。</p>
  </header>

  <section class="mb-8 rounded-xl border border-ink-200 bg-white p-5" aria-labelledby="path-heading">
    <h2 id="path-heading" class="text-sm font-semibold text-ink-900">推荐学习路径</h2>
    <ol class="mt-3 flex flex-wrap gap-2">
      {
        learningPath.map((item, index) => (
          <li>
            <a
              href={item.href}
              class="inline-flex items-center gap-2 rounded-lg bg-ink-50 px-3 py-1.5 text-sm text-ink-800 hover:bg-brand-50 hover:text-brand-700"
            >
              <span class="font-semibold text-brand-600">{index + 1}</span>
              {item.title}
            </a>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="mb-8" aria-labelledby="hubs-heading">
    <h2 id="hubs-heading" class="sr-only">模型与分类</h2>
    <div class="flex flex-wrap gap-2">
      {
        modelHubs.map((hub) => (
          <a href={hub.href} class="tag hover:bg-brand-100">
            {hub.name} 专栏
          </a>
        ))
      }
      <a href="/compare/" class="tag hover:bg-brand-100">模型评测</a>
      <a href="/access/" class="tag hover:bg-brand-100">访问说明</a>
      {
        categories.map((cat) => (
          <a href={`/guides/category/${cat.slug}/`} class="rounded-md bg-ink-50 px-2.5 py-0.5 text-xs text-ink-700 hover:bg-brand-50 hover:text-brand-700">
            {cat.name}
          </a>
        ))
      }
    </div>
  </section>

  <div class="grid gap-6 sm:grid-cols-2">
    {items.map((guide) => <ArticleCard guide={guide} />)}
  </div>

  {
    totalPages > 1 && (
      <nav class="mt-10 flex items-center justify-center gap-2" aria-label="分页">
        <span class="btn-secondary cursor-not-allowed px-3 py-2 opacity-40">上一页</span>
        <span class="px-3 text-sm text-ink-600">
          {current} / {totalPages}
        </span>
        {hasNext ? (
          <a href="/guides/page/2/" class="btn-secondary px-3 py-2">
            下一页
          </a>
        ) : (
          <span class="btn-secondary cursor-not-allowed px-3 py-2 opacity-40">下一页</span>
        )}
      </nav>
    )
  }

  <Fragment slot="sidebar">
    <Sidebar popularGuides={allGuides} tags={tags} />
  </Fragment>
</BlogLayout>
