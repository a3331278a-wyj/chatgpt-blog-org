---
/**
 * 文章列表分页页 /guides/page/2/
 */
import BlogLayout from '@layouts/BlogLayout.astro';
import ArticleCard from '@components/blog/ArticleCard.astro';
import Sidebar from '@components/blog/Sidebar.astro';
import { siteConfig } from '@config/site';
import { getPublishedGuides, getTagCloud, paginate } from '@utils/guides';
import { buildBreadcrumbSchema } from '@utils/schema';

export async function getStaticPaths() {
  const guides = await getPublishedGuides();
  const totalPages = Math.max(1, Math.ceil(guides.length / siteConfig.postsPerPage));
  // 第 1 页由 /guides/ 承担，这里从 2 开始
  const pages = [];
  for (let page = 2; page <= totalPages; page += 1) {
    pages.push({ params: { page: String(page) } });
  }
  // 若不足 2 页，生成占位避免空 paths 报错（Astro 允许空数组）
  return pages;
}

const pageNum = Number(Astro.params.page ?? '2');
const allGuides = await getPublishedGuides();
const tags = await getTagCloud();
const { items, current, totalPages, total, hasPrev, hasNext } = paginate(
  allGuides,
  pageNum,
  siteConfig.postsPerPage,
);

const schema = buildBreadcrumbSchema([
  { name: '首页', url: siteConfig.url },
  { name: '教程指南', url: `${siteConfig.url}/guides/` },
  { name: `第 ${current} 页`, url: `${siteConfig.url}/guides/page/${current}/` },
]);
---

<BlogLayout
  title={`AI 教程指南 - 第 ${current} 页`}
  description={`ChatGPT、Claude、Gemini 教程指南第 ${current} 页，共 ${total} 篇文章。`}
  canonical={`/guides/page/${current}/`}
  schema={schema}
  breadcrumbs={[
    { label: '首页', href: '/' },
    { label: '教程指南', href: '/guides/' },
    { label: `第 ${current} 页` },
  ]}
>
  <header class="mb-8">
    <h1 class="font-display text-3xl font-bold tracking-tight text-ink-950">教程指南</h1>
    <p class="mt-2 text-ink-600">第 {current} 页 · 共 {total} 篇文章</p>
  </header>

  <div class="grid gap-6 sm:grid-cols-2">
    {items.map((guide) => <ArticleCard guide={guide} />)}
  </div>

  <nav class="mt-10 flex items-center justify-center gap-2" aria-label="分页">
    {
      hasPrev ? (
        <a
          href={current === 2 ? '/guides/' : `/guides/page/${current - 1}/`}
          class="btn-secondary px-3 py-2"
        >
          上一页
        </a>
      ) : (
        <span class="btn-secondary cursor-not-allowed px-3 py-2 opacity-40">上一页</span>
      )
    }
    <span class="px-3 text-sm text-ink-600">{current} / {totalPages}</span>
    {
      hasNext ? (
        <a href={`/guides/page/${current + 1}/`} class="btn-secondary px-3 py-2">
          下一页
        </a>
      ) : (
        <span class="btn-secondary cursor-not-allowed px-3 py-2 opacity-40">下一页</span>
      )
    }
  </nav>

  <Fragment slot="sidebar">
    <Sidebar popularGuides={allGuides} tags={tags} />
  </Fragment>
</BlogLayout>
