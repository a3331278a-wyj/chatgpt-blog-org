---
/**
 * 文章详情页
 */
import { render } from 'astro:content';
import GuideLayout from '@layouts/GuideLayout.astro';
import RelatedPosts from '@components/blog/RelatedPosts.astro';
import { siteConfig } from '@config/site';
import {
  getPublishedGuides,
  getAdjacentGuides,
  getRelatedGuides,
  estimateReadingMinutes,
  formatDate,
  getCategoryName,
  type GuideEntry,
} from '@utils/guides';
import { buildArticleSchema, buildBreadcrumbSchema, buildHowToSchema } from '@utils/schema';

export async function getStaticPaths() {
  const guides = await getPublishedGuides();
  return guides.map((guide) => ({
    params: { slug: guide.id },
    props: { guide },
  }));
}

interface Props {
  guide: GuideEntry;
}

const { guide } = Astro.props;
const { Content, headings } = await render(guide);

const allGuides = await getPublishedGuides();
const related = getRelatedGuides(guide, allGuides, 3);
const { prev, next } = getAdjacentGuides(guide, allGuides);
const readingMinutes = estimateReadingMinutes(guide.body ?? guide.data.description);

const pageUrl = `${siteConfig.url}/guides/${guide.id}/`;
const ogImage = guide.data.cover ?? siteConfig.defaultOgImage;

const schema = [
  buildArticleSchema(guide, pageUrl),
  buildBreadcrumbSchema([
    { name: '首页', url: siteConfig.url },
    { name: '教程指南', url: `${siteConfig.url}/guides/` },
    {
      name: getCategoryName(guide.data.category),
      url: `${siteConfig.url}/guides/category/${guide.data.category}/`,
    },
    { name: guide.data.title, url: pageUrl },
  ]),
  ...(guide.data.howToSteps?.length
    ? [buildHowToSchema(guide, pageUrl, guide.data.howToSteps)]
    : []),
];
---

<GuideLayout
  title={guide.data.title}
  description={guide.data.description}
  canonical={`/guides/${guide.id}/`}
  image={ogImage}
  type="article"
  publishedTime={guide.data.pubDate.toISOString()}
  modifiedTime={(guide.data.updatedDate ?? guide.data.pubDate).toISOString()}
  author={guide.data.author}
  tags={guide.data.tags}
  schema={schema}
  headings={headings}
  breadcrumbs={[
    { label: '首页', href: '/' },
    { label: '教程指南', href: '/guides/' },
    {
      label: getCategoryName(guide.data.category),
      href: `/guides/category/${guide.data.category}/`,
    },
    { label: guide.data.title },
  ]}
>
  <header class="mb-8 border-b border-ink-200 pb-8">
    <div class="flex flex-wrap items-center gap-2">
      <a href={`/guides/category/${guide.data.category}/`} class="tag">
        {getCategoryName(guide.data.category)}
      </a>
      {
        guide.data.tags.map((tag: string) => (
          <a
            href={`/tags/${tag}/`}
            class="rounded-md bg-ink-50 px-2.5 py-0.5 text-xs text-ink-600 hover:bg-brand-50 hover:text-brand-700"
          >
            #{tag}
          </a>
        ))
      }
    </div>
    <h1 class="mt-4 font-display text-3xl font-extrabold tracking-tight text-ink-950 text-balance sm:text-4xl">
      {guide.data.title}
    </h1>
    <p class="mt-4 text-lg text-ink-600">{guide.data.description}</p>
    <dl class="mt-5 flex flex-wrap gap-x-5 gap-y-2 text-sm text-ink-500">
      <div class="flex gap-1.5">
        <dt class="sr-only">作者</dt>
        <dd>{guide.data.author}</dd>
      </div>
      <div class="flex gap-1.5">
        <dt class="sr-only">发布时间</dt>
        <dd>
          <time datetime={guide.data.pubDate.toISOString()}>
            {formatDate(guide.data.pubDate)}
          </time>
        </dd>
      </div>
      <div class="flex gap-1.5">
        <dt class="sr-only">阅读时长</dt>
        <dd>约 {readingMinutes} 分钟阅读</dd>
      </div>
    </dl>
  </header>

  {
    guide.data.cover && (
      <figure class="mb-10 overflow-hidden rounded-xl bg-ink-100">
        <img
          src={guide.data.cover}
          alt={guide.data.coverAlt ?? guide.data.title}
          width="1200"
          height="630"
          loading="eager"
          decoding="sync"
          class="cover-img"
        />
      </figure>
    )
  }

  <div class="prose-blog">
    <Content />
  </div>

  <nav
    class="mt-12 grid gap-4 border-t border-ink-200 pt-8 sm:grid-cols-2"
    aria-label="上下篇文章"
  >
    <div>
      {
        prev ? (
          <a
            href={`/guides/${prev.id}/`}
            class="block rounded-xl border border-ink-200 bg-white p-4 transition hover:border-brand-300"
          >
            <span class="text-xs font-medium uppercase tracking-wide text-ink-400">上一篇</span>
            <span class="mt-1 block font-semibold text-ink-900">{prev.data.title}</span>
          </a>
        ) : (
          <span class="block rounded-xl border border-dashed border-ink-200 p-4 text-sm text-ink-400">
            已是最早一篇
          </span>
        )
      }
    </div>
    <div class="sm:text-right">
      {
        next ? (
          <a
            href={`/guides/${next.id}/`}
            class="block rounded-xl border border-ink-200 bg-white p-4 transition hover:border-brand-300"
          >
            <span class="text-xs font-medium uppercase tracking-wide text-ink-400">下一篇</span>
            <span class="mt-1 block font-semibold text-ink-900">{next.data.title}</span>
          </a>
        ) : (
          <span class="block rounded-xl border border-dashed border-ink-200 p-4 text-sm text-ink-400">
            已是最新一篇
          </span>
        )
      }
    </div>
  </nav>

  <RelatedPosts guides={related} />

  <section
    class="mt-12 rounded-xl border border-dashed border-ink-200 bg-ink-50/60 p-6"
    aria-labelledby="comments-heading"
  >
    <h2 id="comments-heading" class="font-display text-lg font-bold text-ink-900">评论</h2>
    <p class="mt-2 text-sm text-ink-500">
      评论功能即将上线，欢迎先通过关于页联系我们反馈意见。
    </p>
  </section>
</GuideLayout>
