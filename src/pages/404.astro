---
/**
 * 404 页面
 */
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout
  title="页面未找到"
  description="你访问的页面不存在或已迁移，请返回首页、教程指南或使用站内搜索。"
  noindex={true}
>
  <div class="container-site flex min-h-[60vh] flex-col items-center justify-center py-16 text-center">
    <p class="text-sm font-semibold uppercase tracking-wider text-brand-600">404</p>
    <h1 class="mt-3 font-display text-3xl font-bold text-ink-950 sm:text-4xl">页面未找到</h1>
    <p class="mt-4 max-w-lg text-ink-600">
      链接可能已失效，或内容已迁移到新的专栏/标签页。你可以继续浏览教程、模型评测或使用站内搜索。
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="btn-primary">返回首页</a>
      <a href="/guides/" class="btn-secondary">教程指南</a>
      <a href="/search/" class="btn-secondary">站内搜索</a>
      <a href="/sitemap/" class="btn-secondary">网站地图</a>
    </div>
  </div>
</BaseLayout>
