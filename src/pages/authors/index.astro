---
/**
 * 作者页（E-E-A-T）
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/common/Breadcrumb.astro';
import { siteConfig } from '@config/site';
import { getPublishedGuides } from '@utils/guides';
import { buildBreadcrumbSchema } from '@utils/schema';

const guides = await getPublishedGuides();
const schema = [
  buildBreadcrumbSchema([
    { name: '首页', url: siteConfig.url },
    { name: '作者', url: `${siteConfig.url}/authors/` },
  ]),
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: siteConfig.author,
    url: `${siteConfig.url}/authors/`,
    description: '负责 ChatGPT、Claude、Gemini 等 AI 大模型教程、评测与工具指南的编辑团队。',
    email: siteConfig.email,
    worksFor: {
      '@type': 'Organization',
      name: siteConfig.name,
      url: siteConfig.url,
    },
  },
];
---

<BaseLayout
  title="作者与编辑部"
  description="了解 ChatGPT博客编辑部的内容原则、更新方式与联系渠道，增强内容可信度与可追溯性。"
  canonical="/authors/"
  schema={schema}
>
  <div class="container-site py-8 lg:py-10">
    <Breadcrumb items={[{ label: '首页', href: '/' }, { label: '作者' }]} />

    <article class="mx-auto mt-6 max-w-3xl">
      <h1 class="font-display text-3xl font-bold text-ink-950">作者与编辑部</h1>
      <p class="mt-4 text-lg text-ink-600">
        {siteConfig.author}负责本站教程、评测、快讯与工具指南的策划与更新。
      </p>

      <section class="prose-blog mt-10">
        <h2>内容原则</h2>
        <ul>
          <li>优先写可执行步骤与对照表，少写空泛形容词</li>
          <li>涉及访问与付费信息时，强调合规与官方来源</li>
          <li>重要页面标注更新日期，过时内容会修订或加注</li>
          <li>不提供违规访问教程，不导流来路不明站点</li>
        </ul>

        <h2>联系与纠错</h2>
        <p>
          发现错误或希望投稿选题，请邮件：
          <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
        </p>

        <h2>最近发布（{Math.min(8, guides.length)}）</h2>
      </section>

      <ul class="mt-4 space-y-2">
        {
          guides.slice(0, 8).map((guide) => (
            <li>
              <a href={`/guides/${guide.id}/`} class="text-brand-700 hover:underline">
                {guide.data.title}
              </a>
            </li>
          ))
        }
      </ul>
    </article>
  </div>
</BaseLayout>
